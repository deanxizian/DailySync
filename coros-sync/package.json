{
  "name": "dailysync-garmin-cn-coros-cn",
  "version": "1.0.0",
  "private": true,
  "description": "Isolated bidirectional Garmin CN and COROS CN migration and sync tools.",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "migrate_garmin_cn_to_coros": "ts-node src/migrate_garmin_cn_to_coros.ts",
    "migrate_coros_cn_to_garmin_cn": "ts-node src/migrate_coros_cn_to_garmin_cn.ts",
    "sync_garmin_cn_to_coros": "ts-node src/sync_garmin_cn_to_coros.ts",
    "sync_coros_cn_to_garmin_cn": "ts-node src/sync_coros_cn_to_garmin_cn.ts",
    "test": "node --test tests/sync/*.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.214.0",
    "@gooin/garmin-connect": "1.8.7",
    "ali-oss": "6.23.0",
    "axios": "1.20.0",
    "crypto-js": "4.2.0",
    "dotenv": "17.4.2",
    "form-data": "4.0.6",
    "json-bigint": "1.0.0",
    "jszip": "3.10.1",
    "sqlite": "5.1.1",
    "sqlite3": "6.0.1"
  },
  "devDependencies": {
    "@types/node": "16.18.126",
    "ts-node": "10.9.2",
    "typescript": "4.9.5",
    "yaml": "2.9.0"
  }
}
