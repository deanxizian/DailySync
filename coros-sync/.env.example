# Copy this file to coros-sync/.env.local. Never commit real credentials.
GARMIN_USERNAME=
GARMIN_SYNC_NUM=10
GARMIN_MIGRATE_NUM=100
GARMIN_MIGRATE_START=0
GARMIN_MIGRATE_AUTO_PAGE=true
COROS_USERNAME=
COROS_PASSWORD=

# Only needed if the existing db/garmin.db was already encrypted with a non-default AESKEY.
# AESKEY=

# GARMIN_PASSWORD is intentionally unsupported by this bridge.
